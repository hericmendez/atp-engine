        {
          "name": "Search Games",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/games/search?q= mega man",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "games",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": " mega man",
                  "description": "Search text. Required, non-empty (covers: max 200 chars)."
                },
                {
                  "key": "source",
                  "value": "",
                  "disabled": true,
                  "description": "Accepted by validation but currently not forwarded to the game search service (unused). On covers/search it optionally restricts to one provider source."
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": true,
                  "description": "Page number. Optional, integer >= 1, default 1."
                },
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": true,
                  "description": "Page size. Optional, integer 1-100, default 20."
                },
                {
                  "key": "sort",
                  "value": "",
                  "disabled": true,
                  "description": "Sort field. Game endpoints: title, createdAt, updatedAt, completeness, releaseDate, name. Platform summary: name, releaseYear, gameCount. Sync history: startedAt, completedAt, status, trigger."
                },
                {
                  "key": "order",
                  "value": "desc",
                  "disabled": true,
                  "description": "Sort direction asc/desc. Default desc (games, sync history) / asc (platforms)."
                },
                {
                  "key": "discover",
                  "value": "true",
                  "disabled": true,
                  "description": "Opt-in live discovery on a miss. When discovery runs, provider failures surface as a top-level errors[] (sanitized, no upstream URLs)."
                }
              ]
            },
            "description": "Database-first game search. 1) DB hit returns origin database without contacting providers. 2) DB miss without discover returns empty origin database. 3) DB miss with discover=true runs provider discovery: persisted candidates return origin database; nothing persistable returns origin scraper. Validated candidates are persisted; rejected ones go to quarantine. When discovery runs, provider failures appear as a sanitized top-level errors[] (source, errorType, message, retryable); errors: [] means discovery ran cleanly. HTTP stays 200 for partial or total provider failure. The errors field is absent unless discovery ran."
          },
          "response": [
            {
              "name": "Database hit",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"data\": [\n    {\n      \"id\": \"atp-igdb-12345\",\n      \"titles\": [\n        {\n          \"value\": \"Example Game\",\n          \"type\": \"primary\"\n        }\n      ],\n      \"releases\": [],\n      \"developers\": [\n        {\n          \"name\": \"Example Studio\"\n        }\n      ],\n      \"publishers\": [\n        {\n          \"name\": \"Example Publisher\"\n        }\n      ],\n      \"genres\": [\n        {\n          \"name\": \"Action\"\n        }\n      ],\n      \"externalIdentifiers\": [\n        {\n          \"source\": \"igdb\",\n          \"id\": \"12345\"\n        }\n      ],\n      \"relationships\": [],\n      \"evidence\": [\n        {\n          \"source\": \"igdb\",\n          \"externalId\": \"12345\",\n          \"retrievedAt\": \"2025-01-01T00:00:00.000Z\",\n          \"rawTitle\": \"Example Game\"\n        }\n      ],\n      \"classification\": \"GAME\",\n      \"completeness\": \"FOUND_SUFFICIENT\"\n    }\n  ],\n  \"pagination\": {\n    \"page\": 1,\n    \"limit\": 20,\n    \"total\": 1,\n    \"totalPages\": 1\n  },\n  \"origin\": \"database\"\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "Database miss without discover",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"data\": [],\n  \"pagination\": {\n    \"page\": 1,\n    \"limit\": 20,\n    \"total\": 0,\n    \"totalPages\": 1\n  },\n  \"origin\": \"database\"\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },
