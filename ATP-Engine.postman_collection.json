                }
              ],
              "body": "{\n  \"status\": \"ok\",\n  \"timestamp\": \"2025-01-01T00:00:00.000Z\",\n  \"version\": \"0.1.0\",\n  \"dependencies\": {\n    \"database\": \"connected\",\n    \"ai\": \"not_configured\"\n  },\n  \"uptime\": 123.4\n}",
