                  "description": "Filter by developer; accepts comma-separated list."
                },
                {
                  "key": "publisher",
                  "value": "",
                  "disabled": true,
                  "description": "Filter by publisher; accepts comma-separated list."
                },
                {
                  "key": "genre",
                  "value": "",
                  "disabled": true,
                  "description": "Filter by genre; accepts comma-separated list."
                },
                {
                  "key": "classification",
                  "value": "",
                  "disabled": true,
                  "description": "GAME, DLC, EXPANSION, MOVIE, TV_SHOW, ANIME, SOUNDTRACK, BOOK, HARDWARE, PROMOTIONAL, CHARACTER, FRANCHISE, PERSON, EVENT, UNKNOWN."
                },
                {
                  "key": "completeness",
                  "value": "",
                  "disabled": true,
                  "description": "NOT_FOUND, FOUND_PARTIAL, FOUND_SUFFICIENT, FOUND_COMPLETE."
