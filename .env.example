PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/atp-engine
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
AI_ENABLED=false
SOURCE_TIMEOUT=10000
LOG_LEVEL=info
# Server-side only. Minimum 16 characters. Never commit a real value.
# Example generation: openssl rand -hex 32
ADMIN_API_TOKEN=change-me-to-a-random-secret-at-least-16-chars
# Admin dashboard login (HttpOnly session). Server-side only.
# Requires scrypt hash with random salt. Generate via:
#   pnpm --filter atp-engine exec tsx scripts/generate-admin-hash.ts <password>
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=scrypt:16384:8:1:<saltHex>:<hashHex>
